void startBLEBeacon() {
  if (!priorityActive || !patientOnBoard || !emergencyActive) {
    stopBLEBeacon();
    return;
  }

  if (!bleAdvertising) {
    NimBLEDevice::init(BLE_DEVICE_NAME);

    NimBLEServer* server = NimBLEDevice::createServer();
    (void)server;

    bleAdvertising = NimBLEDevice::getAdvertising();
  }

  NimBLEAdvertisementData advertisementData;
  advertisementData.setName(BLE_DEVICE_NAME);

  String payload =
    "AMB=" + String(AMBULANCE_ID) +
    ";EMG=" + emergencyId +
    ";PRI=1";

  advertisementData.setManufacturerData(payload.c_str());

  bleAdvertising->setAdvertisementData(advertisementData);
  bleAdvertising->start();

  Serial.println("[BLE] PRIORITY BEACON ON");
}

void stopBLEBeacon() {
  if (bleAdvertising) {
    bleAdvertising->stop();
  }
}

